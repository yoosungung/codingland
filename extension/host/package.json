{
  "name": "codingland",
  "displayName": "Codingland",
  "description": "Epistemic-debt debug microworld for Cursor/VS Code",
  "version": "0.0.1",
  "publisher": "yoosungung",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codingland",
          "title": "Codingland",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "codingland": [
        {
          "type": "webview",
          "id": "codingland.sidebar",
          "name": "Agent & Debt"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "codingland.canvas",
        "displayName": "Codingland Canvas",
        "selector": [
          {
            "filenamePattern": "*.codingland.json"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "codingland.revealBeside",
        "title": "Codingland: Reveal Beside"
      },
      {
        "command": "codingland.showPanel",
        "title": "Codingland: Show Panel Log"
      },
      {
        "command": "codingland.openCanvas",
        "title": "Codingland: Open Canvas"
      },
      {
        "command": "codingland.loadPaymentSample",
        "title": "Codingland: Load Payment Middleware Sample"
      },
      {
        "command": "codingland.triggerGate",
        "title": "Codingland: Trigger Mirror Gate"
      }
    ],
    "configuration": {
      "title": "Codingland",
      "properties": {
        "codingland.mirror.cloudOptIn": {
          "type": "boolean",
          "default": false,
          "description": "Opt in to cloud Mirror draft path (default off; local Heuristic Mirror). Inputs are sanitized before egress (ARCHITECTURE §1.8)."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "@codingland/core": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.7.3"
  }
}
